#include <stdio.h>
#include "lexer.h"
#define MAX 50

int main(void){
    char exp[MAX];
    Token tokens[MAX];

    printf("Enter expression:");
    fgets(exp,MAX,stdin);

    printf("After conversion:\n");
    int count = token_conversion(exp,tokens);
    for(int i=0;i<count;i++){
        switch(tokens[i].type){
        case TOK_NUM : printf("NUM(%d) ",tokens[i].value); break;
        case TOK_PLUS : printf("PLUS "); break;
        case TOK_MINUS : printf("MINUS "); break;
        case TOK_STAR : printf("STAR "); break;
        case TOK_SLASH : printf("SLASH "); break;
        case TOK_POWER : printf("POWER "); break;
        case TOK_LPARAN : printf("LPARAN "); break;
        case TOK_RPARAN : printf("RPARAN "); break;
        default : printf("Failed.\n"); return 1;
        }
    }
    return 0;
}
